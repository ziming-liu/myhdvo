# Quick test Dockerfile - Only tests system packages installation
FROM nvcr.io/nvidia/pytorch:25.08-py3

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Test system package installation with host network
RUN apt-get update && apt-get install -y \
    libxcb1 \
    libx11-6 \
    libxrender1 \
    libxrandr2 \
    libxinerama1 \
    libxi6 \
    libgl1-mesa-glx \
    python3-tk \
    && rm -rf /var/lib/apt/lists/*

# Quick Python test
RUN python3 -c "import torch; print('PyTorch OK:', torch.__version__)"

CMD ["/bin/bash"]
